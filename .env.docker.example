# ============================================================
#  TaskBoard — переменные окружения для docker compose.
#
#  Скопируйте этот файл в .env рядом с docker-compose.yml
#  и подставьте свои значения:
#
#     cp .env.docker.example .env      (Linux/macOS)
#     copy .env.docker.example .env    (Windows)
#
#  .env в .gitignore, в репозиторий секреты не попадут.
# ============================================================

# ------------------------------------------------------------
#  База данных
# ------------------------------------------------------------
POSTGRES_DB=taskboard
DB_USERNAME=postgres
# ОБЯЗАТЕЛЬНО смените. Пароль для локального postgres.
DB_PASSWORD=change-me-strong-db-password

# ------------------------------------------------------------
#  JWT — ОБЯЗАТЕЛЬНО смените
#  Нужен длинный случайный секрет (>= 32 байт) для HS256.
#  Сгенерировать:
#     openssl rand -base64 48
#     или PowerShell:
#     [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
# ------------------------------------------------------------
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-for-hs256-please
APP_JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------
#  Порт, на котором сайт будет доступен снаружи.
#  80 — обычный http. Если 80 занят (или ставите за общий nginx),
#  поставьте, например, 8080.
# ------------------------------------------------------------
FRONTEND_PORT=80
