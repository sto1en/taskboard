# Пример переменных окружения backend. Скопируйте и заполните значения для прода.
# В dev приложение запускается без них (используются дефолты из application.properties).

# База данных
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — ОБЯЗАТЕЛЬНО задайте длинный случайный секрет (>=32 байт) в проде
APP_JWT_SECRET=change-me-to-a-very-long-secret-key-at-least-32-bytes-long-for-hs256
APP_JWT_EXPIRATION_MS=86400000

# Отладка SQL (в проде false)
JPA_SHOW_SQL=false

# Загрузка файлов
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=http://localhost:8082/uploads
