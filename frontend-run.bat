@echo off
REM Файл сохранён в CP866 - родной кодировке cmd.exe на русской Windows.
REM НЕ пересохраняйте в UTF-8: cmd.exe начнёт парсить русские комментарии
REM как мусор и ломать строки. chcp не вызываем, чтобы echo выводил
REM кириллицу корректно.
setlocal EnableDelayedExpansion

REM ============================================================
REM  TaskBoard - ?? ????? + ??????? ????? ?? Nginx.
REM
REM  ??? ????:
REM    frontend-run.bat            -> ??: nginx:8081 ???? frontend\dist
REM    frontend-run.bat --dev      -> dev:  Vite ?? 5173 (hot reload)
REM
REM  ??? ???? ????? 0.0.0.0, ????? ?????? ? ?? ngrok.
REM ============================================================

set "PROJECT_ROOT=D:\projects\taskBoard"
set "FRONTEND_DIR=%PROJECT_ROOT%\frontend"
set "NGINX_DIR=D:\utilities\nginx-1.30.4"
set "NGINX_EXE=%NGINX_DIR%\nginx.exe"
set "NGINX_CONF=%NGINX_DIR%\conf\nginx.conf"

REM --- ?????: prod (?? ?????) ??? dev ---
set "MODE=prod"
if /I "%~1"=="--dev" set "MODE=dev"
if /I "%~1"=="dev"   set "MODE=dev"

if /I "%MODE%"=="dev" (
    set "TASKBOARD_URL=http://localhost:5173"
    set "APP_PORT=5173"
) else (
    set "TASKBOARD_URL=http://localhost:8081"
    set "APP_PORT=8081"
)

echo.
echo ============================================================
echo   TaskBoard - ????? ????? [???: %MODE%]
echo ============================================================
echo.

if not exist "%FRONTEND_DIR%\package.json" (
    echo [??????] ?? ?????? %FRONTEND_DIR%\package.json
    goto :error
)
if not exist "%NGINX_EXE%" (
    echo [??????] ?? ?????? Nginx: %NGINX_EXE%
    goto :error
)
if not exist "%NGINX_CONF%" (
    echo [??????] ?? ?????? ???? Nginx: %NGINX_CONF%
    goto :error
)

REM ============================================================
REM  DEV-?????: ?? Vite, ??? nginx ? ??? ??.
REM ============================================================
if /I "%MODE%"=="dev" (
    echo [1/2] ???? ??? Vite...
    if exist "%FRONTEND_DIR%\node_modules\.vite" rmdir /s /q "%FRONTEND_DIR%\node_modules\.vite"
    echo       OK
    echo.

    echo [2/2] ???? Vite dev-??? ?? ????? %APP_PORT%...
    echo       ????????: Ctrl+C
    echo.
    cd /d "%FRONTEND_DIR%"

    REM ?????? ????, ???? Vite ???????????.
    start "" /B cmd /c "timeout /t 4 /nobreak >nul & start "" "%TASKBOARD_URL%""

    call npm run dev -- --host 0.0.0.0 --port %APP_PORT%
    goto :end
)

REM ============================================================
REM  PROD-?????: ?? + nginx:8081
REM ============================================================
echo [0/6] ??????????? ???? ?????? Nginx...
taskkill /F /IM nginx.exe >nul 2>&1
echo       OK
echo.

echo [1/6] ???? dist ? ??? Vite...
if exist "%FRONTEND_DIR%\dist" rmdir /s /q "%FRONTEND_DIR%\dist"
if exist "%FRONTEND_DIR%\node_modules\.vite" rmdir /s /q "%FRONTEND_DIR%\node_modules\.vite"
echo       OK
echo.

echo [2/6] ???? React...
cd /d "%FRONTEND_DIR%"
call npm run build
if errorlevel 1 (
    echo.
    echo [??????] ???? React ?? ?????
    goto :error
)
echo       OK
echo.

echo [3/6] ???? dist\index.html...
if not exist "%FRONTEND_DIR%\dist\index.html" (
    echo [??????] ?? ?????? %FRONTEND_DIR%\dist\index.html
    goto :error
)
echo       OK
echo.

echo [4/6] ???? ????? Nginx...
REM ?????: ????? -p (prefix) ? -c (????) ??.
REM app-??? (:8081) ????? ? conf\taskboard.conf ? ??????????
REM ?????? include ?? nginx.conf.
"%NGINX_EXE%" -p "%NGINX_DIR%" -c "%NGINX_CONF%" -t
if errorlevel 1 (
    echo [??????] ???? Nginx ???????
    goto :error
)
echo       OK
echo.

echo [5/6] ???? Nginx...
start "" /B "%NGINX_EXE%" -p "%NGINX_DIR%" -c "%NGINX_CONF%"
ping -n 3 127.0.0.1 >nul

REM ?????, ?? nginx ??????? ??????? ? ???? ????.
tasklist /FI "IMAGENAME eq nginx.exe" 2>nul | find /I "nginx.exe" >nul
if errorlevel 1 (
    echo [??????] Nginx ?? ????????. ?????? ???:
    echo          %NGINX_DIR%\logs\error.log
    goto :error
)
echo       OK
echo.

echo [6/6] ???? HTTP ?? ????? %APP_PORT%:
curl -s -o nul -w "  /          %%{http_code}\n" "%TASKBOARD_URL%/"
