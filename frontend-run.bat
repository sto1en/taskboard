curl -s -o nul -w "  /api/ping  %%{http_code}\n" "%TASKBOARD_URL%/api/ping"
echo.
echo       ^(??? 000 = nginx ????????;  502/504 = backend ?? ?????^)
echo.

echo ============================================================
echo   ??????:  %TASKBOARD_URL%
echo   ??? ngrok (? ????? ????):
echo       ngrok http %APP_PORT%
echo   ????? ?? ??: http://^<???-LAN-IP^>:%APP_PORT%
echo ============================================================
start "" "%TASKBOARD_URL%"

echo.
echo Nginx ???? ? ??. ???? ????? ??????? - ??? ??????? ????.
echo ???????? ???: taskkill /F /IM nginx.exe
echo.
pause
exit /b 0

:error
echo.
echo ============================================================
echo   ?????? ?????????? ? ???????
echo ============================================================
pause
exit /b 1

:end
exit /b 0
